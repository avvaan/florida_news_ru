# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Django ---
DJANGO_DEBUG=1                       # на проде: 0
DJANGO_SECRET_KEY=                   # на проде обязательно: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=         # на проде: https://ваш-домен
SITE_URL=http://localhost:8000       # публичный адрес сайта без слеша в конце (для Telegram, sitemap, canonical)
DATABASE_URL=                        # пусто = SQLite; на Render подставляется автоматически
# MEDIA_ROOT=/var/data/media         # постоянный диск для картинок рекламы на Render
# SERVE_MEDIA=1                      # отдавать /media/ самим Django (для небольших сайтов на Render)
DEMO_MODE=0
GOOGLE_SITE_VERIFICATION=            # значение content из мета-тега Google Search Console                          # 1 = плашка «демо-данные» (вместе с manage.py seed_demo)

# --- ИИ ---
AI_PROVIDER=deepseek                 # deepseek (по умолчанию) или anthropic
DEEPSEEK_API_KEY=                    # https://platform.deepseek.com → API keys
# DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_CLASSIFIER_MODEL=deepseek-flash  # отбор; проверьте названия: python manage.py check_ai
AI_VERIFIER_MODEL=deepseek-flash    # проверка фактов
AI_WRITER_MODEL=deepseek-v4-pro        # написание заметок
# AI_PRICING_JSON={"deepseek-flash": {"input": "0.30", "cache_read": "0.03", "output": "1.20"}}

# Если вернётесь на Anthropic: AI_PROVIDER=anthropic, ANTHROPIC_API_KEY=..., модели claude-*
# ANTHROPIC_API_KEY=
# AI_WRITER_EFFORT=medium

# --- Сигналы из соцсетей (только подсказки; включаются галочками в админке) ---
PERPLEXITY_API_KEY=                  # https://www.perplexity.ai/settings/api
XAI_API_KEY=                         # https://console.x.ai
TG_API_ID=                           # https://my.telegram.org → API development tools
TG_API_HASH=
TG_SESSION=                          # строка от: python manage.py telegram_login
# PERPLEXITY_MODEL=perplexity/sonar
# XAI_MODEL=grok-4.7
# SIGNALS_BUDGET_SHARE=0.7

# --- Telegram ---
TELEGRAM_BOT_TOKEN=                  # от @BotFather
TELEGRAM_CHANNEL_ID=                 # @имя_канала или -100xxxxxxxxxx
TELEGRAM_CHANNEL_URL=https://t.me/   # ссылка для кнопки «Подписаться»
# Отправка включается отдельно галочкой в админке: Настройки → «отправлять в Telegram».

# --- Сбор ---
# FETCH_USER_AGENT=FloridaRUBot/1.0 (+https://ваш-домен/about/)

# Картинки из форм (афиша): проверяет Claude со зрением, хранит ImageKit. Без них — события без картинок.
# ANTHROPIC_API_KEY=                 # нужен и для проверки картинок (AI_VISION_MODEL, по умолчанию claude-haiku-5-5)
IMAGEKIT_PRIVATE_KEY=                # ImageKit → Developer options → API keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=               # https://ik.imagekit.io/<ваш_id>
# IMAGEKIT_FOLDER=/florida-ru
