# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Django ---
DJANGO_DEBUG=1                       # на проде: 0
DJANGO_SECRET_KEY=                   # на проде обязательно: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=         # на проде: https://ваш-домен
SITE_URL=http://localhost:8000       # публичный адрес сайта без слеша в конце (для Telegram, sitemap, canonical)
DATABASE_URL=                        # пусто = SQLite; на Render подставляется автоматически
# MEDIA_ROOT=/var/data/media         # постоянный диск для картинок рекламы на Render
# SERVE_MEDIA=1                      # отдавать /media/ самим Django (для небольших сайтов на Render)
DEMO_MODE=0                          # 1 = плашка «демо-данные» (вместе с manage.py seed_demo)

# --- ИИ (Anthropic) ---
ANTHROPIC_API_KEY=
AI_CLASSIFIER_MODEL=claude-haiku-4-5 # отбор; дешевле в 10 раз: claude-haiku-5-5
AI_VERIFIER_MODEL=claude-haiku-4-5   # проверка фактов
AI_WRITER_MODEL=claude-sonnet-5      # написание заметок
AI_WRITER_EFFORT=medium              # low / medium / high

# --- Telegram ---
TELEGRAM_BOT_TOKEN=                  # от @BotFather
TELEGRAM_CHANNEL_ID=                 # @имя_канала или -100xxxxxxxxxx
TELEGRAM_CHANNEL_URL=https://t.me/   # ссылка для кнопки «Подписаться»
# Отправка включается отдельно галочкой в админке: Настройки → «отправлять в Telegram».

# --- Сбор ---
# FETCH_USER_AGENT=FloridaSegodnyaBot/1.0 (+https://ваш-домен/p/about/)
