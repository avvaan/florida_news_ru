msgstr "Інших подій поки немає"

#: templates/events/list.html:36
#, python-format
msgid ""
"Организуете концерт, праздник или встречу? <a "
"href=\"%(submit_url)s\">Добавьте событие</a> — это бесплатно."
msgstr ""
