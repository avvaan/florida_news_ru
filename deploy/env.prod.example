# Настройки сайта на домашнем сервере (docker-compose.yml читает deploy/.env.prod).
#
# Настоящий файл:  bash deploy/init-env.sh
# Он копирует этот файл в deploy/.env.prod (в git не попадает, читается только
# владельцем) и вписывает DJANGO_SECRET_KEY и пароль базы. Ключи API и токен
# туннеля впишите сами.
#
# В ЭТОТ файл настоящие значения не пишите: он в репозитории.
# Одна строка KEY=value, без кавычек, комментарии — только на отдельных строках.
# Полный список переменных и что они значат — .env.example.

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=florida-ru.com,www.florida-ru.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://florida-ru.com,https://www.florida-ru.com
SITE_URL=https://florida-ru.com
# Картинки рекламы и фото авторов (том media в docker-compose.yml).
MEDIA_ROOT=/app/media
SERVE_MEDIA=1
GOOGLE_SITE_VERIFICATION=

# ── База (сервис db) ─────────────────────────────────────────────────────────
POSTGRES_DB=florida
POSTGRES_USER=florida
# init-env.sh генерирует пароль и вписывает его же в DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://florida:POSTGRES_PASSWORD_HERE@db:5432/florida

# ── ИИ ───────────────────────────────────────────────────────────────────────
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
AI_CLASSIFIER_MODEL=deepseek-flash
AI_VERIFIER_MODEL=deepseek-flash
AI_WRITER_MODEL=deepseek-v4-pro
# Проверка картинок из форм (зрение) и дедупликация.
ANTHROPIC_API_KEY=

# ── Сигналы из соцсетей (включаются галочками в админке) ─────────────────────
PERPLEXITY_API_KEY=
XAI_API_KEY=
TG_API_ID=
TG_API_HASH=
TG_SESSION=

# ── Telegram-канал ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_URL=

# ── ImageKit (картинки афиши) ────────────────────────────────────────────────
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# `cloudflared tunnel token florida-ru` на mimi (README → «Домашний сервер mimi»).
TUNNEL_TOKEN=
