      "css": ".ds-weather{background:var(--ink,#0f2433);color:#fff;border-radius:12px;padding:24px;font-family:\"Golos Text\",system-ui,sans-serif;}.ds-weather-h{margin:0;font-weight:800;font-size:1.5rem;line-height:1.15;letter-spacing:-.02em}.ds-alerts{list-style:none;margin:14px 0 0;padding:0;display:grid;gap:8px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}.ds-alert{display:grid;gap:8px;align-content:start;padding:10px 12px;border-radius:8px;background:rgb(255 255 255 / .06)}.ds-sev{justify-self:start;padding:4px 8px 3px;border-radius:4px;font-family:\"Unbounded\",\"Golos Text\",system-ui,sans-serif;font-weight:800;font-size:.65rem;line-height:1.2;text-transform:uppercase;letter-spacing:.05em;background:var(--mist,#eaf5f3);color:var(--ink,#0f2433)}.ds-sev--x{background:var(--storm,#c2410c);color:#fff}.ds-sev--s{background:var(--sun,#ffc93c)}.ds-time{color:var(--shallow,#7fd1c7);font-size:.85rem;font-variant-numeric:tabular-nums}.ds-wlink{display:inline-block;margin-top:14px;color:var(--sun,#ffc93c);font-weight:600}.ds-wlink:focus-visible{outline:3px solid var(--sun,#ffc93c);outline-offset:2px}"
